<h1>Showing post</h1>
<h3><%= @post.title%></h3>
<%= link_to favorite_text, favorites_update_path(post: @post), id: "favorite_link" %>
<p><%= @post.body%></p>
<p><%= @post.user.email %></p>
<% if @post.image.attached? %>
    <p><%= image_tag(@post.image_thumbnail) %></p>
<% end %>
<% if @post.file.attached? %>
    <p><%= link_to 'Download' , @post.file , download: '' %>
<% end %>

<% if @post.clip.attached? %>
    <p><%= video_tag(url_for(@post.clip), controls: true, size: "320x240") %></p>
<% end %>
<h2>Post a Comment</h2>

<%= form_with(model: [@post, @comment], remote: true) do |f| %>
    <%= f.text_field :body %>
    <%= f.submit "Add Comment" %>
<%end%>

<h2>Comments</h2>

<div id="comments-section">
    <% @comments.each do |comment| %>
        <%= render 'comments/comment', comment: comment %>
    <% end %>
</div>
<br>

<%= link_to "All Posts", posts_path%>
<%= link_to "Edit post" , edit_post_path(@post) %>
<%= button_to "Delete", delete_post_path(@post),
              method: :delete,
              data: { turbo_confirm: "Are you sure?" } %>
